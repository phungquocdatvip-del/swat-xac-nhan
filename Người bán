<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Quản lý đơn hàng</title>
<style>
body { font-family: Arial; background: #f4f4f4; padding: 20px; }
h1 { text-align: center; color: #333; margin-bottom: 20px; }
table { width: 100%; border-collapse: collapse; background: #fff; }
th, td { padding: 12px; text-align: center; border-bottom: 1px solid #ddd; }
th { background: #007BFF; color: #fff; }
tr:hover { background: #f1f1f1; }
button { padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; color: white; margin: 2px; }
.btn-confirm { background-color: #28a745; }
.btn-cancel { background-color: #dc3545; }
.status { padding: 4px 8px; border-radius: 4px; color: white; display: inline-block; }
.status-pending { background-color: #ffc107; }
.status-confirmed { background-color: #28a745; }
.status-cancelled { background-color: #dc3545; }
</style>
</head>
<body>

<h1>Quản lý đơn hàng</h1>

<table id="ordersTable">
    <thead>
        <tr>
            <th>ID</th>
            <th>Khách hàng</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Địa chỉ</th>
            <th>Sản phẩm</th>
            <th>Số lượng</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        <!-- Bảng sẽ được JS thêm vào -->
    </tbody>
</table>

<script>
// Lấy dữ liệu từ LocalStorage
let orders = JSON.parse(localStorage.getItem("orders")) || [];

// Render bảng
function renderOrders(){
    const tbody = document.querySelector("#ordersTable tbody");
    tbody.innerHTML = "";
    orders.forEach(order => {
        let statusClass = "";
        if(order.status=="Chờ xác nhận") statusClass="status-pending";
        if(order.status=="Đã xác nhận") statusClass="status-confirmed";
        if(order.status=="Đã hủy") statusClass="status-cancelled";

        let tr = document.createElement("tr");
        tr.innerHTML = `
            <td>${order.id}</td>
            <td>${order.name}</td>
            <td>${order.email}</td>
            <td>${order.phone}</td>
            <td>${order.address}</td>
            <td>${order.product}</td>
            <td>${order.qty}</td>
            <td>${order.total}</td>
            <td><span class="status ${statusClass}">${order.status}</span></td>
            <td>
                ${order.status=="Chờ xác nhận" ? 
                  `<button class="btn-confirm" onclick="updateStatus(${order.id}, 'Đã xác nhận')">Xác nhận</button>
                   <button class="btn-cancel" onclick="updateStatus(${order.id}, 'Đã hủy')">Hủy</button>` 
                  : "Đã xử lý"}
            </td>
        `;
        tbody.appendChild(tr);
    });
}

// Cập nhật trạng thái
function updateStatus(id, status){
    orders = orders.map(o => o.id===id ? {...o, status: status} : o);
    localStorage.setItem("orders", JSON.stringify(orders));
    renderOrders();
}

renderOrders();
</script>

</body>
</html>
